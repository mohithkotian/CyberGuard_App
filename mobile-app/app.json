{
  "expo": {
    "name": "CyberGuard",
    "slug": "cyberguard-app",
    "scheme": "cyberguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "package": "com.cyberguard.app",
      "permissions": [
        "NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cyberguard.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Upload evidence photos",
        "NSPhotoLibraryUsageDescription": "Upload evidence from library"
      }
    },
    "plugins": [
      "expo-notifications"
    ]
  }
}
